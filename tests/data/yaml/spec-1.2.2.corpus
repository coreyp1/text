# YAML 1.2.2 cases that yaml-test-suite does not contain.
#
# Every case here was found by reading the specification rather than by
# running the suite, and each was confirmed absent from the suite's 406
# documents before being written down. That absence is the whole point: for a
# long stretch this parser scored 100% on a corpus that never asked the
# questions it got wrong, three separate times, and a score is only ever a
# score over the documents somebody chose. These are the documents nobody
# else chose.
#
# Prefer upstreaming a case to yaml-test-suite over keeping it here. This file
# is for what the suite does not cover yet, not a second home for it.
#
# FORMAT
#
#   @case  <name>          one line, free text, used in failure output
#   @yaml                  the input, verbatim on the lines that follow
#   @json                  expected output, one JSON document per line
#   @error <substring>     ...or: the parse must fail, with this in the message
#   @end
#
# Only those five words, at column 0, are special. Outside a case, a line
# starting with "#" is a comment.
#
# Inside @yaml and @json alike: "\t" is a tab, "\0" a NUL, "\xNN" and
# "\uNNNN" a code point, and "\\" a single backslash. Nearly every case here
# turns on a character that is invisible, or that an editor would eat, or
# that cannot go in a text file at all, so none of them is written literally.
# A backslash the expectation really contains is "\\" - which comes up in
# expected JSON, where the writer spells a tab inside a string as the two
# characters "\t".

# ---------------------------------------------------------------------------
# 10.3.2  Core schema resolution
#
# The rows of the resolution table are lists of spellings, not
# case-insensitive words. Matching them case-insensitively resolved a whole
# family of spellings the spec leaves alone.
# ---------------------------------------------------------------------------

@case mixed-case "true" is a string, not a boolean
@yaml
a: tRue
b: TrUe
c: trUE
@json
{"a":"tRue","b":"TrUe","c":"trUE"}
@end

@case the six boolean spellings the core schema lists
@yaml
[true, True, TRUE, false, False, FALSE]
@json
[true,true,true,false,false,false]
@end

@case mixed-case "false" is a string
@yaml
a: fAlse
@json
{"a":"fAlse"}
@end

@case mixed-case "null" is a string
@yaml
a: nULL
b: NuLL
@json
{"a":"nULL","b":"NuLL"}
@end

@case the four null spellings the core schema lists
@yaml
[null, Null, NULL, ~]
@json
[null,null,null,null]
@end

@case ".Nan" is a string; only .nan, .NaN and .NAN are not-a-number
@yaml
a: .Nan
b: .INf
@json
{"a":".Nan","b":".INf"}
@end

@case an underscore digit separator is YAML 1.1, so 1.2 sees a string
@yaml
a: 1_000
b: 1_0.5
@json
{"a":"1_000","b":"1_0.5"}
@end

@case a binary literal is YAML 1.1, so 1.2 sees a string
@yaml
a: 0b101
@json
{"a":"0b101"}
@end

@case the octal and hex prefixes are lower case in 1.2
@yaml
a: 0o14
b: 0x1f
c: 0O14
d: 0X1f
@json
{"a":12,"b":31,"c":"0O14","d":"0X1f"}
@end

@case a leading zero is not octal in 1.2
@yaml
a: 014
@json
{"a":"014"}
@end

@case an explicit !!int must hold what the int tag's syntax admits
@yaml
a: !!int 0b101
@error Invalid integer scalar for explicit tag
@end

# ---------------------------------------------------------------------------
# 6.8  Directives
#
# s-separate-in-line is s-white+, and s-white is a space *or a tab* (5.5).
# ---------------------------------------------------------------------------

@case a tab may separate %YAML from its version
@yaml
%YAML\t1.2
---
v
@json
"v"
@end

@case spaces and tabs may be mixed in %YAML separation
@yaml
%YAML \t 1.2
---
v
@json
"v"
@end

@case a tab may separate %TAG from its handle
@yaml
%TAG\t!e! tag:example.com,2000:
---
!e!a v
@json
"v"
@end

@case a tab may separate a %TAG handle from its prefix
@yaml
%TAG !e!\ttag:example.com,2000:
---
!e!a v
@json
"v"
@end

@case one %TAG per handle per document (6.8.2)
@yaml
%TAG !e! tag:example.com,2000:
%TAG !e! tag:example.org,2000:
---
v
@error Repeated TAG directive for one handle
@end

@case two %TAG directives for different handles are fine
@yaml
%TAG !e! tag:example.com,2000:
%TAG !f! tag:example.org,2000:
---
v
@json
"v"
@end

@case a major version this parser does not implement is refused (6.8.1)
@yaml
%YAML 2.0
---
v
@error major version
@end

@case a newer minor version is parsed anyway (6.8.1)
@yaml
%YAML 1.3
---
v
@json
"v"
@end

@case a directive prologue needs a "---" after it (9.2)
@yaml
%YAML 1.2
v
@error Directives must be followed by '---'
@end

@case a %TAG prologue needs one too
@yaml
%TAG !e! tag:example.com,2000:
v
@error Directives must be followed by '---'
@end

@case a comment may stand between the directive and the marker
@yaml
%YAML 1.2
# nothing to see
---
v
@json
"v"
@end

@case the marker may carry the document on its own line
@yaml
%YAML 1.2
--- text
@json
"text"
@end

# ---------------------------------------------------------------------------
# 7.1  Node properties and alias nodes
# ---------------------------------------------------------------------------

@case an alias refers to a *preceding* anchor, never a later one
@yaml
a: *x
b: &x 1
@error Unknown anchor referenced by alias
@end

@case the same, in a sequence
@yaml
- *x
- &x 1
@error Unknown anchor referenced by alias
@end

@case an anchor written before the collection it names may be used inside it
@yaml
a: &x [1]
b: *x
@json
{"a":[1],"b":[1]}
@end

@case a redefined anchor means the most recent one
@yaml
a: &x 1
b: &x 2
c: *x
@json
{"a":1,"b":2,"c":2}
@end

@case an alias node carries no anchor of its own
@yaml
a: &x 1
b: &y *x
@error An alias node may not carry an anchor
@end

@case an alias node carries no tag either
@yaml
a: &x 1
b: !!str *x
@error An alias node may not carry a tag
@end

@case a verbatim tag needs at least one character
@yaml
!<> 1
@error Empty verbatim tag
@end

@case a verbatim tag is taken exactly as written
@yaml
!<tag:yaml.org,2002:str> 1
@json
"1"
@end

# ---------------------------------------------------------------------------
# 5.1  c-printable
#
#   c-printable ::= #x9 | #xA | #xD | [#x20-#x7E] | #x85 | [#xA0-#xD7FF]
#                 | [#xE000-#xFFFD] | [#x10000-#x10FFFF]
#
# Every production bottoms out in it, so a character outside it cannot appear
# in a document in any style, quoted or not. Nothing enforced it at all, and
# the NUL was the worst of them: "a: x\0y" came back as {"a": "x"} with the
# rest of the scalar simply gone. PyYAML and js-yaml refuse all of these. The
# suite contains no case with a non-printable character anywhere in it.
# ---------------------------------------------------------------------------

@case a NUL is not a character a stream may contain
@yaml
a: x\0y
@error Character not allowed in a YAML stream
@end

@case nor an ESC - and a quoted scalar is no exception
@yaml
a: "x\x1by"
@error Character not allowed in a YAML stream
@end

@case nor DEL, which falls outside [#x20-#x7E]
@yaml
a: x\x7fy
@error Character not allowed in a YAML stream
@end

@case nor a C1 control, which falls below #xA0
@yaml
a: x\x9fy
@error Character not allowed in a YAML stream
@end

@case tab, NEL, LS and PS are printable - and 1.2 breaks on LF and CR alone
@yaml
a: "x\ty"
b: x\x85y
c: x\u2028y
@json
{"a":"x\\ty","b":"x\x85y","c":"x\u2028y"}
@end

@case an escape still builds whatever it names: the stream stays printable
@yaml
a: "\\u0001"
b: "\\e"
@json
{"a":"\\u0001","b":"\\u001B"}
@end

# ---------------------------------------------------------------------------
# 5.2  The byte order mark
#
# l-document-prefix ::= c-byte-order-mark? l-comment*, and the stream admits
# a prefix before every document rather than only the first - which was all
# that was accepted, because the mark is eaten by encoding detection and
# nothing downstream knew it existed. Elsewhere U+FEFF is excluded from
# nb-char (5.4), so it cannot stand in a plain or block scalar; the quoted
# styles are built from nb-json, which does admit it.
# ---------------------------------------------------------------------------

@case a mark may open the stream
@yaml
\ufeffa: 1
@json
{"a":1}
@end

@case a mark may open a later document, before its "---"
@yaml
a: 1
...
\ufeff---
b: 2
@json
{"a":1}
{"b":2}
@end

@case ...and before a "---" that no "..." preceded
@yaml
a: 1
\ufeff---
b: 2
@json
{"a":1}
{"b":2}
@end

@case ...and before a bare document that a "..." closed off
@yaml
a: 1
...
\ufeffb: 2
@json
{"a":1}
{"b":2}
@end

@case a mark is not nb-char, so it cannot stand in a plain scalar
@yaml
a: x\ufeffy
@error Byte order mark in scalar content
@end

@case nor in a block scalar
@yaml
a: |
  x\ufeffy
@error Byte order mark in scalar content
@end

@case but a quoted scalar is built from nb-json, which admits it
@yaml
a: "x\ufeffy"
b: 'x\ufeffy'
@json
{"a":"x\ufeffy","b":"x\ufeffy"}
@end

@case a mark inside an open document is refused, and says which fault it is
@yaml
a: 1
\ufeffb: 2
@error Byte order mark inside a document
@end

# --- 5.3, c-non-specific-tag: "!" on its own is a whole tag property -------
# The shorthand's name begins at the byte after the "!", so a "!" that is not
# followed immediately by a name is the non-specific tag and an ordinary node
# follows it.  The scanner used to read that node as the tag's name - which
# takes a ":" with it, since ns-tag-char excludes only the flow indicators -
# and the stream never recorded where the "!" was written, so it was carried
# past the empty node it belonged to and hung on the next one.

@case a bare "!" before a value that was never written
@yaml
a: !
b: 2
@json
{"a":"","b":2}
@end

@case and before a sequence entry that was never written
@yaml
- !
- x
@json
["","x"]
@end

@case up against a flow indicator, which cannot be part of a tag name
@yaml
[!]
@json
[""]
@end

@case or against the end of the stream, where no node can follow it
@yaml
!
@json
""
@end

# --- 6.8.2.2: the secondary handle names one tag, however it is spelled -----

@case a verbatim tag in the standard namespace is the shorthand's tag
@yaml
!<tag:yaml.org,2002:str> 23
@json
"23"
@end

@case and a named handle pointed at that namespace resolves to it too
@yaml
%TAG !y! tag:yaml.org,2002:
---
!y!int 0x1f
@json
31
@end

# --- 8.1.1.1 / 6.9.2: a node begins where its properties begin -------------
# The properties are held until the node they name arrives, and reported with
# it, so an anchored key arrived at the column of its scalar.  Under a value
# that was never written that put it inside the value rather than beside the
# key.

@case an anchored key under an empty value is the next key, not the value
@yaml
a: 1
b:
&anchor c: 3
@json
{"a":1,"b":null,"c":3}
@end

@case and a tagged one likewise
@yaml
b:
!!str c: 3
@json
{"b":null,"c":3}
@end

@case a scalar at the mapping's own column with no ":" is still an error
@yaml
b:
&anchor c
@error Scalar with no
@end

# --- 6.9.2: ns-anchor-char is ns-char minus c-flow-indicator ---------------
# The first character of an anchor or alias name was the one place the rule
# was not applied. Nine of the ninety-four printable ASCII characters were
# refused there - ! " # % & ' * | > - because each was taken for what it
# means somewhere else: a tag, a quoted scalar, a comment, a directive,
# another anchor, an alias, a block scalar. The name came out empty and the
# document was in error.
#
# None of these shapes is in yaml-test-suite. The writer is what produced
# them: it will spell any anchor a caller gives it, and a round trip of a
# document built through the DOM API is what asked the question.

@case an anchor name may begin with "!"
@yaml
&!x v
@json
"v"
@end

@case an anchor name may begin with "&"
@yaml
&&x v
@json
"v"
@end

@case an anchor name may begin with "*"
@yaml
&*x v
@json
"v"
@end

@case an anchor name may begin with "#", which starts no comment there
@yaml
&#x v
@json
"v"
@end

@case an anchor name may begin with a block scalar indicator
@yaml
&|x v
@json
"v"
@end

@case an anchor name may begin with a quote
@yaml
&"x v
@json
"v"
@end

@case an alias is held to the same production
@yaml
a: &!x 1
b: *!x
@json
{"a":1,"b":1}
@end

@case but a flow indicator still ends the name
@yaml
&[x v
@error Parse error
@end

# --- 5.7: the numeric escapes all name a character, not a byte -------------
# "\x" was handled apart from "\u" and "\U" and wrote the raw byte, which is
# right below U+0080 and wrong above it: "\x92" produced a lone 0x92, and a
# lone continuation byte is not UTF-8. The writer spells a C1 control
# "\x92", so the parser refused what the writer had just produced.

@case a hex escape names a character and is encoded as one
@yaml
"a\\x92b"
@json
"a\u0092b"
@end

@case the 8-bit and 16-bit escapes agree above U+007F
@yaml
- "\\xE9"
- "\\u00E9"
@json
["\u00e9","\u00e9"]
@end

@case an escape needs its hex digits
@yaml
"a\\xZZb"
@error hex digits
@end

@case and the 16-bit one likewise, rather than giving U+FFFD
@yaml
"a\\uZZZZb"
@error hex digits
@end

# --- 5.6 / 5.3: c-verbatim-tag is "!" "<" ns-uri-char+ ">" -----------------
# Only the "+" of that was enforced. A space, a tab, a brace, a quotation
# mark, a non-ASCII byte and a bare "%" all travelled through as part of the
# tag.

@case a verbatim tag may not hold a space
@yaml
!<a b> v
@error URI character
@end

@case a verbatim tag may not hold a non-ASCII character
@yaml
!<café> v
@error URI character
@end

@case a "%" in a verbatim tag needs two hex digits
@yaml
!<a%zzb> v
@error URI character
@end

@case and with them it is one URI character
@yaml
!<a%21b> v
@json
"v"
@end

# --- 5.3: a verbatim tag is used exactly as written ------------------------
# The brackets were stripped in the stream layer, and after that nothing
# distinguished "!<!a!>" from the shorthand "!a!". The writer fuzzer found it
# from a tag of "!&!".

@case a verbatim tag is not a shorthand, whatever its URI looks like
@yaml
!<!a!> v
@json
"v"
@end

@case and no %TAG expands one
@yaml
%TAG ! tag:e.com,2000:
---
!<!a> v
@json
"v"
@end

# --- 6.9.1: a shorthand tag's name may begin with any ns-tag-char -----------
# "!-" is the tag "!-", and the "-" was being taken for a block entry
# indicator. "!-[]" parsed - the "[" ends the name before anything can misread
# it - so only putting a space after the tag showed it, which is exactly what
# the writer does.

@case a tag name may begin with "-"
@yaml
!- []
@json
[]
@end

@case and with ":"
@yaml
!:x []
@json
[]
@end

@case and with "?"
@yaml
!?x []
@json
[]
@end

@case but a flow indicator still ends it
@yaml
!x[]
@json
[]
@end

@case and with "#", which starts no comment there
@yaml
!#x []
@json
[]
@end

@case but "|" is not a URI character, so it still opens a block scalar
@yaml
!| 1
@error block scalar header
@end
